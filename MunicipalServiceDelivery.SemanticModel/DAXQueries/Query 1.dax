// Open Now, Active and Stuck in Power BI vs the pipeline's reference values
EVALUATE
VAR expected =
    DATATABLE (
        "As at", DATETIME, "Open (pipeline)", INTEGER, "Active (pipeline)", INTEGER, "Stuck (pipeline)", INTEGER,
        {
            { "2020-03-31", 14504, 14504, 0 },
            { "2020-06-30", 15107, 9489, 5618 },
            { "2020-09-30", 22853, 15685, 7168 },
            { "2020-12-31", 30845, 21015, 9830 }
        }
    )
VAR compared =
    ADDCOLUMNS (
        expected,
        "Open Now", VAR d = [As at] RETURN CALCULATE ( [Open Now], as_at[as_at_date] = d ),
        "Active", VAR d = [As at] RETURN CALCULATE ( [Active], as_at[as_at_date] = d ),
        "Stuck", VAR d = [As at] RETURN CALCULATE ( [Stuck], as_at[as_at_date] = d )
    )
RETURN
    SELECTCOLUMNS (
        compared,
        "As at", FORMAT ( [As at], "yyyy-mm-dd" ),
        "Open Now", [Open Now],
        "Active", [Active],
        "Stuck", [Stuck],
        "Result", IF ( [Open Now] = [Open (pipeline)] && [Active] = [Active (pipeline)] && [Stuck] = [Stuck (pipeline)], "PASS", "FAIL" )
    )