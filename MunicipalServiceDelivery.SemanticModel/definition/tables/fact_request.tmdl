/// One row per clean Water and Sanitation field-work service request created in 2020 (City of Cape Town). Quarantined rows are in 'quarantine'.
table fact_request
	lineageTag: 1bb80c5e-c015-40c1-9a3f-286c44ddff59

	measure 'Open Now' =
			
			VAR t = MAX ( as_at[as_at_end] )               -- 1. the end of the chosen day
			RETURN
			    CALCULATE (
			        COUNTROWS ( fact_request ),
			        fact_request[created_at] <= t,                                          -- 2. created on or before t
			        ISBLANK ( fact_request[completed_at] ) || fact_request[completed_at] > t  -- 3. still open at t
			    )
		formatString: #,0
		lineageTag: f3c49969-4c23-46ca-9523-01fd1a20af89

	measure Active =
			
			VAR d = MAX ( as_at[as_at_date] )
			RETURN
			    CALCULATE ( [Open Now], fact_request[created_date] >= d - 90 )
		formatString: #,0
		lineageTag: 19f00fa0-fca3-4ece-bca5-edde40c9b11a

	measure Stuck = [Open Now] - [Active]
		formatString: #,0
		lineageTag: 14a01013-0f9e-4187-8ce0-0abb633ee4b3

	/// Clean requests created in the period (via the active created_date relationship). Includes likely repeats and admin closures.
	measure 'Requests In' = COUNTROWS ( fact_request )
		formatString: #,0
		lineageTag: e17e533c-3a8f-4784-b450-9cdde5972612

	/// Clean requests completed in the period, excluding admin closures (closed within 5 minutes). Uses the inactive completed_date relationship.
	measure Completions =
			CALCULATE (
			    COUNTROWS ( fact_request ),
			    USERELATIONSHIP ( fact_request[completed_date], dim_date[date] ),  -- dates now mean completion dates
			    NOT ISBLANK ( fact_request[completed_at] ),                          -- open requests are not completions
			    fact_request[is_admin_closure] = FALSE ()                            -- admin closures are not repairs
			)
		formatString: #,0
		lineageTag: d3ae6add-6a5e-4dc4-9ba5-3a8579230d42

	/// Requests In minus Completions: positive means open work grew in the period.
	measure 'Net Change' = [Requests In] - [Completions]
		formatString: +#,0;-#,0;0
		lineageTag: e73bc53c-597f-40a4-98db-3e4db53c1885

	/// Completions over the four full Monday-to-Sunday weeks ending on or before the as-at date, divided by 4. Ignores any date filter: the window is set by the as_at slicer.
	measure 'Avg Weekly Completions' =
			VAR d = MAX ( as_at[as_at_date] )
			VAR dow = WEEKDAY ( d, 2 )                                -- 1 = Monday ... 7 = Sunday
			VAR window_end = d - dow + 1 + IF ( dow = 7, 7, 0 )       -- Monday after the last full week (exclusive)
			VAR window_start = window_end - 28                        -- four weeks earlier
			RETURN
			    DIVIDE (
			        CALCULATE (
			            [Completions],
			            REMOVEFILTERS ( dim_date ),
			            dim_date[date] >= window_start,
			            dim_date[date] < window_end
			        ),
			        4
			    )
		formatString: #,0.00
		lineageTag: 830f5118-92f1-41cc-9e7f-ce19450d7e0c

	measure 'Weeks to Clear' =
			
			VAR avg_done = [Avg Weekly Completions]    -- weekly throughput: the measure we just added
			RETURN
			    IF (
			        avg_done < 5,                  -- too little throughput to give a stable figure
			        BLANK (),
			        DIVIDE ( [Active], avg_done )  -- work that crews can clear: open work under 90 days old
			    )
		lineageTag: 1df9f1a3-c3b8-4217-a969-c327e1580a64

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// City notification number.
	column request_id
		dataType: string
		lineageTag: 8dc1096d-2a23-4ec6-9f32-8e282d938407
		sourceColumn: request_id

	/// Creation time, SAST.
	column created_at
		dataType: dateTime
		lineageTag: 2a6c21fe-9be7-492a-ba1e-9f506623bbc3
		sourceColumn: created_at

	/// Completion time, SAST. Blank if never completed.
	column completed_at
		dataType: dateTime
		lineageTag: 99c9e8be-c472-4a22-8bbe-218e672ce592
		sourceColumn: completed_at

	column created_date
		dataType: dateTime
		formatString: Short Date
		lineageTag: 3fd7b328-c2ef-4be7-8d89-76ab0ad1d7c5
		summarizeBy: none
		sourceColumn: created_date

		annotation UnderlyingDateTimeDataType = Date

		annotation SummarizationSetBy = Automatic

	column completed_date
		dataType: dateTime
		formatString: Short Date
		lineageTag: c3cc5168-2005-4fe6-b43f-6b0b62531246
		summarizeBy: none
		sourceColumn: completed_date

		annotation UnderlyingDateTimeDataType = Date

		annotation SummarizationSetBy = Automatic

	column section_key
		dataType: int64
		isHidden
		lineageTag: 81859baf-3a80-4104-b153-cf0314b7f4ef
		summarizeBy: none
		sourceColumn: section_key

	column fault_type_key
		dataType: int64
		isHidden
		lineageTag: d5b70568-747a-44ee-989a-b6873ff14232
		summarizeBy: none
		sourceColumn: fault_type_key

	column suburb_key
		dataType: int64
		isHidden
		lineageTag: 71963428-b142-4d07-9aba-34ab962ed0a1
		summarizeBy: none
		sourceColumn: suburb_key

	column hex_key
		dataType: int64
		isHidden
		lineageTag: e20fcfd9-70c0-428c-81dd-3ffbcc56377b
		summarizeBy: none
		sourceColumn: hex_key

	/// Completed minus created, in days. Excludes nothing: filter out admin closures in measures.
	column days_to_complete
		dataType: double
		formatString: 0.0
		lineageTag: d18ab5a5-66dd-4300-b3c4-64f9ae00b88a
		summarizeBy: none
		sourceColumn: days_to_complete

	/// Closed within 5 minutes of creation: counted as a request, excluded from durations and completions.
	column is_admin_closure
		dataType: boolean
		lineageTag: c3ef8f19-da6e-4231-a5c3-66a9b348a1b5
		sourceColumn: is_admin_closure

	/// Later report of the same fault type in the same hexagon on the same SAST day.
	column is_likely_repeat
		dataType: boolean
		lineageTag: 46527e1f-c974-4577-bf43-a294ea5e12a8
		sourceColumn: is_likely_repeat

	/// Has an H3 hexagon; unlocated requests cannot appear on the map.
	column is_located
		dataType: boolean
		lineageTag: be02ff66-cd1c-4b72-b9e7-413ba82774cb
		sourceColumn: is_located

	partition fact_request = m
		mode: import
		source =
				let
				    Source = Parquet.Document(File.Contents(DataFolder & "fact_request.parquet"))
				in
				    Source

