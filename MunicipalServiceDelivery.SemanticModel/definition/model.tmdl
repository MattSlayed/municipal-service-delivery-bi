model Model
	culture: en-ZA
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-ZA
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode","MCP-PBIModeling"]

annotation PBI_QueryOrder = ["fact_request","dim_date","dim_section","dim_fault_type","dim_suburb","dim_hex","as_at","dq_summary","quarantine","DataFolder"]

ref table fact_request
ref table dim_date
ref table dim_section
ref table dim_fault_type
ref table dim_suburb
ref table dim_hex
ref table as_at
ref table dq_summary
ref table quarantine

ref cultureInfo en-ZA

