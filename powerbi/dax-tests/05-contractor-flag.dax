// Contractor Flag and Flagged Sections
// Every section at the default threshold of 3 weeks, and the count of flagged sections per date.
// Generated by scripts/build_dax_tests.py from the pipeline's reference values. Do not edit by hand.
EVALUATE
VAR expected =
    DATATABLE (
        "As at", DATETIME, "Section", STRING, "Flag (pipeline)", INTEGER,
        {
        { "2020-03-31", "Billing Management", 0 },
        { "2020-03-31", "CRM", 0 },
        { "2020-03-31", "Policy, Strategy Regulation & Water Pollution", 0 },
        { "2020-03-31", "Reticulation Water Distribution", 0 },
        { "2020-03-31", "Debt Management", 0 },
        { "2020-03-31", "Reticulation WW Conveyance", 0 },
        { "2020-03-31", "Informal Settlements:Operating and Maintenance", 0 },
        { "2020-03-31", "Meter Management", 0 },
        { "2020-03-31", "Reticulation (unassigned)", 0 },
        { "2020-03-31", "Bulk Water Operations", 0 },
        { "2020-03-31", "Fleet Management & Mechanical Workshop", 0 },
        { "2020-03-31", "Operations (South)", 0 },
        { "2020-03-31", "Revenue Management (Water)", 0 },
        { "2020-03-31", "Water Demand Management & Operational Im", 0 },
        { "2020-06-30", "Debt Management", 0 },
        { "2020-06-30", "Billing Management", 0 },
        { "2020-06-30", "Informal Settlements:Operating and Maintenance", 1 },
        { "2020-06-30", "Policy, Strategy Regulation & Water Pollution", 0 },
        { "2020-06-30", "Reticulation WW Conveyance", 1 },
        { "2020-06-30", "Reticulation Water Distribution", 0 },
        { "2020-06-30", "Reticulation (unassigned)", 0 },
        { "2020-06-30", "Meter Management", 0 },
        { "2020-06-30", "Bulk Water Operations", 0 },
        { "2020-06-30", "CRM", 0 },
        { "2020-06-30", "Revenue Management (Water)", 0 },
        { "2020-06-30", "Water Demand Management & Operational Im", 0 },
        { "2020-09-30", "Reticulation WW Conveyance", 1 },
        { "2020-09-30", "Billing Management", 0 },
        { "2020-09-30", "Policy, Strategy Regulation & Water Pollution", 0 },
        { "2020-09-30", "CRM", 0 },
        { "2020-09-30", "Reticulation Water Distribution", 0 },
        { "2020-09-30", "Informal Settlements:Operating and Maintenance", 0 },
        { "2020-09-30", "Debt Management", 0 },
        { "2020-09-30", "Meter Management", 0 },
        { "2020-09-30", "Reticulation (unassigned)", 0 },
        { "2020-09-30", "Facilities Management", 0 },
        { "2020-09-30", "Revenue Management (Water)", 0 },
        { "2020-09-30", "Water Demand Management & Operational Im", 0 },
        { "2020-12-31", "Informal Settlements:Operating and Maintenance", 1 },
        { "2020-12-31", "Debt Management", 0 },
        { "2020-12-31", "Billing Management", 0 },
        { "2020-12-31", "Reticulation WW Conveyance", 1 },
        { "2020-12-31", "Reticulation Water Distribution", 1 },
        { "2020-12-31", "Policy, Strategy Regulation & Water Pollution", 0 },
        { "2020-12-31", "Meter Management", 0 },
        { "2020-12-31", "Reticulation (unassigned)", 0 },
        { "2020-12-31", "Bulk Water Operations", 0 },
        { "2020-12-31", "CRM", 0 },
        { "2020-12-31", "Revenue Management (Water)", 0 },
        { "2020-12-31", "Unassigned", 0 },
        { "2020-12-31", "Water Demand Management & Operational Im", 0 },
        { "2020-03-31", "(Flagged Sections)", 0 },
        { "2020-06-30", "(Flagged Sections)", 2 },
        { "2020-09-30", "(Flagged Sections)", 1 },
        { "2020-12-31", "(Flagged Sections)", 3 }
        }
    )
VAR compared =
    ADDCOLUMNS (
        expected,
        "Flag", VAR d = [As at] VAR s = [Section] RETURN IF ( s = "(Flagged Sections)", CALCULATE ( [Flagged Sections], as_at[as_at_date] = d ), CALCULATE ( [Contractor Flag], as_at[as_at_date] = d, dim_section[section] = s ) )
    )
VAR checked = ADDCOLUMNS ( compared, "ok", [Flag] = [Flag (pipeline)] )
VAR failures = FILTER ( checked, NOT [ok] )
RETURN
    ROW (
        "Test", "Contractor Flag and Flagged Sections",
        "Checks", COUNTROWS ( checked ),
        "Passed", COUNTROWS ( checked ) - COUNTROWS ( failures ),
        "Result", IF ( ISEMPTY ( failures ), "PASS", "FAIL" ),
        "First failure", CONCATENATEX ( TOPN ( 1, failures, FORMAT ( [As at], "yyyy-mm-dd" ) & " " & [Section], ASC ), FORMAT ( [As at], "yyyy-mm-dd" ) & " " & [Section] )
    )
