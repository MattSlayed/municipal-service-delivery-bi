// Open Now, Active and Stuck
// Department totals at each reference date.
// Generated by scripts/build_dax_tests.py from the pipeline's reference values. Do not edit by hand.
EVALUATE
VAR expected =
    DATATABLE (
        "As at", DATETIME, "Open (pipeline)", INTEGER, "Active (pipeline)", INTEGER, "Stuck (pipeline)", INTEGER,
        {
        { "2020-03-31", 14504, 14504, 0 },
        { "2020-06-30", 15107, 9489, 5618 },
        { "2020-09-30", 22853, 15685, 7168 },
        { "2020-12-31", 30845, 21015, 9830 }
        }
    )
VAR compared =
    ADDCOLUMNS (
        expected,
        "Open", VAR d = [As at] RETURN CALCULATE ( [Open Now], as_at[as_at_date] = d ),
        "Active", VAR d = [As at] RETURN CALCULATE ( [Active], as_at[as_at_date] = d ),
        "Stuck", VAR d = [As at] RETURN CALCULATE ( [Stuck], as_at[as_at_date] = d )
    )
VAR checked = ADDCOLUMNS ( compared, "ok", [Open] = [Open (pipeline)] && [Active] = [Active (pipeline)] && [Stuck] = [Stuck (pipeline)] )
VAR failures = FILTER ( checked, NOT [ok] )
RETURN
    ROW (
        "Test", "Open Now, Active and Stuck",
        "Checks", COUNTROWS ( checked ),
        "Passed", COUNTROWS ( checked ) - COUNTROWS ( failures ),
        "Result", IF ( ISEMPTY ( failures ), "PASS", "FAIL" ),
        "First failure", CONCATENATEX ( TOPN ( 1, failures, FORMAT ( [As at], "yyyy-mm-dd" ), ASC ), FORMAT ( [As at], "yyyy-mm-dd" ) )
    )
