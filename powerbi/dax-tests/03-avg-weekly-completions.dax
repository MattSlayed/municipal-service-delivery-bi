// Avg Weekly Completions by section
// Completions over the four full weeks ending at the as-at date, divided by 4.
// Generated by scripts/build_dax_tests.py from the pipeline's reference values. Do not edit by hand.
EVALUATE
VAR expected =
    DATATABLE (
        "As at", DATETIME, "Section", STRING, "Avg (pipeline)", DOUBLE,
        {
        { "2020-03-31", "Billing Management", 11.75 },
        { "2020-03-31", "CRM", 9.5 },
        { "2020-03-31", "Policy, Strategy Regulation & Water Pollution", 16.75 },
        { "2020-03-31", "Reticulation Water Distribution", 2132.25 },
        { "2020-03-31", "Debt Management", 54.75 },
        { "2020-03-31", "Reticulation WW Conveyance", 1976.75 },
        { "2020-03-31", "Informal Settlements:Operating and Maintenance", 271.5 },
        { "2020-03-31", "Meter Management", 2217.25 },
        { "2020-03-31", "Reticulation (unassigned)", 520.75 },
        { "2020-03-31", "Bulk Water Operations", 0.0 },
        { "2020-03-31", "Fleet Management & Mechanical Workshop", 0.0 },
        { "2020-03-31", "Operations (South)", 0.0 },
        { "2020-03-31", "Revenue Management (Water)", 0.5 },
        { "2020-03-31", "Water Demand Management & Operational Im", 0.0 },
        { "2020-06-30", "Debt Management", 16.25 },
        { "2020-06-30", "Billing Management", 12.0 },
        { "2020-06-30", "Informal Settlements:Operating and Maintenance", 164.5 },
        { "2020-06-30", "Policy, Strategy Regulation & Water Pollution", 12.5 },
        { "2020-06-30", "Reticulation WW Conveyance", 1720.25 },
        { "2020-06-30", "Reticulation Water Distribution", 1528.25 },
        { "2020-06-30", "Reticulation (unassigned)", 613.75 },
        { "2020-06-30", "Meter Management", 968.25 },
        { "2020-06-30", "Bulk Water Operations", 0.0 },
        { "2020-06-30", "CRM", 1.75 },
        { "2020-06-30", "Revenue Management (Water)", 0.75 },
        { "2020-06-30", "Water Demand Management & Operational Im", 0.25 },
        { "2020-09-30", "Reticulation WW Conveyance", 2808.0 },
        { "2020-09-30", "Billing Management", 16.0 },
        { "2020-09-30", "Policy, Strategy Regulation & Water Pollution", 23.0 },
        { "2020-09-30", "CRM", 26.5 },
        { "2020-09-30", "Reticulation Water Distribution", 1780.75 },
        { "2020-09-30", "Informal Settlements:Operating and Maintenance", 258.0 },
        { "2020-09-30", "Debt Management", 50.25 },
        { "2020-09-30", "Meter Management", 1393.5 },
        { "2020-09-30", "Reticulation (unassigned)", 756.75 },
        { "2020-09-30", "Facilities Management", 0.0 },
        { "2020-09-30", "Revenue Management (Water)", 1.5 },
        { "2020-09-30", "Water Demand Management & Operational Im", 0.25 },
        { "2020-12-31", "Informal Settlements:Operating and Maintenance", 126.5 },
        { "2020-12-31", "Debt Management", 21.0 },
        { "2020-12-31", "Billing Management", 9.75 },
        { "2020-12-31", "Reticulation WW Conveyance", 2151.25 },
        { "2020-12-31", "Reticulation Water Distribution", 1314.75 },
        { "2020-12-31", "Policy, Strategy Regulation & Water Pollution", 12.25 },
        { "2020-12-31", "Meter Management", 1768.0 },
        { "2020-12-31", "Reticulation (unassigned)", 653.75 },
        { "2020-12-31", "Bulk Water Operations", 0.0 },
        { "2020-12-31", "CRM", 4.5 },
        { "2020-12-31", "Revenue Management (Water)", 1.0 },
        { "2020-12-31", "Unassigned", 0.0 },
        { "2020-12-31", "Water Demand Management & Operational Im", 0.5 }
        }
    )
VAR compared =
    ADDCOLUMNS (
        expected,
        "Avg", VAR d = [As at] VAR s = [Section] RETURN CALCULATE ( [Avg Weekly Completions], as_at[as_at_date] = d, dim_section[section] = s ) + 0
    )
VAR checked = ADDCOLUMNS ( compared, "ok", IF ( ISBLANK ( [Avg (pipeline)] ), ISBLANK ( [Avg] ), NOT ISBLANK ( [Avg] ) && ABS ( [Avg] - [Avg (pipeline)] ) < 0.000001 ) )
VAR failures = FILTER ( checked, NOT [ok] )
RETURN
    ROW (
        "Test", "Avg Weekly Completions by section",
        "Checks", COUNTROWS ( checked ),
        "Passed", COUNTROWS ( checked ) - COUNTROWS ( failures ),
        "Result", IF ( ISEMPTY ( failures ), "PASS", "FAIL" ),
        "First failure", CONCATENATEX ( TOPN ( 1, failures, FORMAT ( [As at], "yyyy-mm-dd" ) & " " & [Section], ASC ), FORMAT ( [As at], "yyyy-mm-dd" ) & " " & [Section] )
    )
