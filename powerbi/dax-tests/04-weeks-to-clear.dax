// Weeks to Clear by section
// Active / Avg Weekly Completions; blank below 5 completions a week.
// Generated by scripts/build_dax_tests.py from the pipeline's reference values. Do not edit by hand.
EVALUATE
VAR expected =
    DATATABLE (
        "As at", DATETIME, "Section", STRING, "WTC (pipeline)", DOUBLE,
        {
        { "2020-03-31", "Billing Management", 12.595745 },
        { "2020-03-31", "CRM", 7.894737 },
        { "2020-03-31", "Policy, Strategy Regulation & Water Pollution", 4.298507 },
        { "2020-03-31", "Reticulation Water Distribution", 2.879118 },
        { "2020-03-31", "Debt Management", 2.776256 },
        { "2020-03-31", "Reticulation WW Conveyance", 2.755533 },
        { "2020-03-31", "Informal Settlements:Operating and Maintenance", 1.451197 },
        { "2020-03-31", "Meter Management", 0.759048 },
        { "2020-03-31", "Reticulation (unassigned)", 0.716275 },
        { "2020-03-31", "Bulk Water Operations", BLANK () },
        { "2020-03-31", "Fleet Management & Mechanical Workshop", BLANK () },
        { "2020-03-31", "Operations (South)", BLANK () },
        { "2020-03-31", "Revenue Management (Water)", BLANK () },
        { "2020-03-31", "Water Demand Management & Operational Im", BLANK () },
        { "2020-06-30", "Debt Management", 8.184615 },
        { "2020-06-30", "Billing Management", 4.666667 },
        { "2020-06-30", "Informal Settlements:Operating and Maintenance", 4.103343 },
        { "2020-06-30", "Policy, Strategy Regulation & Water Pollution", 3.76 },
        { "2020-06-30", "Reticulation WW Conveyance", 3.039674 },
        { "2020-06-30", "Reticulation Water Distribution", 1.325699 },
        { "2020-06-30", "Reticulation (unassigned)", 0.89613 },
        { "2020-06-30", "Meter Management", 0.739478 },
        { "2020-06-30", "Bulk Water Operations", BLANK () },
        { "2020-06-30", "CRM", BLANK () },
        { "2020-06-30", "Revenue Management (Water)", BLANK () },
        { "2020-06-30", "Water Demand Management & Operational Im", BLANK () },
        { "2020-09-30", "Reticulation WW Conveyance", 3.509972 },
        { "2020-09-30", "Billing Management", 3.25 },
        { "2020-09-30", "Policy, Strategy Regulation & Water Pollution", 2.73913 },
        { "2020-09-30", "CRM", 2.566038 },
        { "2020-09-30", "Reticulation Water Distribution", 1.99635 },
        { "2020-09-30", "Informal Settlements:Operating and Maintenance", 1.957364 },
        { "2020-09-30", "Debt Management", 1.353234 },
        { "2020-09-30", "Meter Management", 0.744887 },
        { "2020-09-30", "Reticulation (unassigned)", 0.626363 },
        { "2020-09-30", "Facilities Management", BLANK () },
        { "2020-09-30", "Revenue Management (Water)", BLANK () },
        { "2020-09-30", "Water Demand Management & Operational Im", BLANK () },
        { "2020-12-31", "Informal Settlements:Operating and Maintenance", 14.988142 },
        { "2020-12-31", "Debt Management", 9.047619 },
        { "2020-12-31", "Billing Management", 8.615385 },
        { "2020-12-31", "Reticulation WW Conveyance", 4.648925 },
        { "2020-12-31", "Reticulation Water Distribution", 3.939152 },
        { "2020-12-31", "Policy, Strategy Regulation & Water Pollution", 2.77551 },
        { "2020-12-31", "Meter Management", 1.611991 },
        { "2020-12-31", "Reticulation (unassigned)", 0.874952 },
        { "2020-12-31", "Bulk Water Operations", BLANK () },
        { "2020-12-31", "CRM", BLANK () },
        { "2020-12-31", "Revenue Management (Water)", BLANK () },
        { "2020-12-31", "Unassigned", BLANK () },
        { "2020-12-31", "Water Demand Management & Operational Im", BLANK () }
        }
    )
VAR compared =
    ADDCOLUMNS (
        expected,
        "WTC", VAR d = [As at] VAR s = [Section] RETURN CALCULATE ( [Weeks to Clear], as_at[as_at_date] = d, dim_section[section] = s )
    )
VAR checked = ADDCOLUMNS ( compared, "ok", IF ( ISBLANK ( [WTC (pipeline)] ), ISBLANK ( [WTC] ), NOT ISBLANK ( [WTC] ) && ABS ( [WTC] - [WTC (pipeline)] ) < 0.000001 ) )
VAR failures = FILTER ( checked, NOT [ok] )
RETURN
    ROW (
        "Test", "Weeks to Clear by section",
        "Checks", COUNTROWS ( checked ),
        "Passed", COUNTROWS ( checked ) - COUNTROWS ( failures ),
        "Result", IF ( ISEMPTY ( failures ), "PASS", "FAIL" ),
        "First failure", CONCATENATEX ( TOPN ( 1, failures, FORMAT ( [As at], "yyyy-mm-dd" ) & " " & [Section], ASC ), FORMAT ( [As at], "yyyy-mm-dd" ) & " " & [Section] )
    )
