// Requests In, Completions and Net Change by week
// Every Monday-to-Sunday week of 2020.
// Generated by scripts/build_dax_tests.py from the pipeline's reference values. Do not edit by hand.
EVALUATE
VAR expected =
    DATATABLE (
        "Week", DATETIME, "In (pipeline)", INTEGER, "Done (pipeline)", INTEGER, "Net (pipeline)", INTEGER,
        {
        { "2020-01-06", 8004, 4713, 3291 },
        { "2020-01-13", 7801, 5823, 1978 },
        { "2020-01-20", 8093, 5795, 2298 },
        { "2020-01-27", 8135, 6415, 1720 },
        { "2020-02-03", 8000, 6758, 1242 },
        { "2020-02-10", 8027, 7224, 803 },
        { "2020-02-17", 7374, 6621, 753 },
        { "2020-02-24", 7450, 6551, 899 },
        { "2020-03-02", 8373, 7719, 654 },
        { "2020-03-09", 6961, 6921, 40 },
        { "2020-03-16", 7234, 8340, -1106 },
        { "2020-03-23", 6026, 5867, 159 },
        { "2020-03-30", 5553, 5514, 39 },
        { "2020-04-06", 4485, 4735, -250 },
        { "2020-04-13", 4505, 3989, 516 },
        { "2020-04-20", 4218, 4470, -252 },
        { "2020-04-27", 4067, 3863, 204 },
        { "2020-05-04", 4635, 4935, -300 },
        { "2020-05-11", 4639, 4902, -263 },
        { "2020-05-18", 4569, 3685, 884 },
        { "2020-05-25", 3995, 4193, -198 },
        { "2020-06-01", 5638, 4732, 906 },
        { "2020-06-08", 5017, 5255, -238 },
        { "2020-06-15", 5305, 5183, 122 },
        { "2020-06-22", 5855, 4984, 871 },
        { "2020-06-29", 6104, 5690, 414 },
        { "2020-07-06", 6542, 5812, 730 },
        { "2020-07-13", 6739, 5715, 1024 },
        { "2020-07-20", 6459, 6022, 437 },
        { "2020-07-27", 6800, 5517, 1283 },
        { "2020-08-03", 7322, 6087, 1235 },
        { "2020-08-10", 6185, 5728, 457 },
        { "2020-08-17", 6937, 5866, 1071 },
        { "2020-08-24", 6732, 5758, 974 },
        { "2020-08-31", 7564, 6114, 1450 },
        { "2020-09-07", 8359, 7988, 371 },
        { "2020-09-14", 7069, 7770, -701 },
        { "2020-09-21", 6194, 6586, -392 },
        { "2020-09-28", 7152, 6092, 1060 },
        { "2020-10-05", 8200, 8628, -428 },
        { "2020-10-12", 8037, 8138, -101 },
        { "2020-10-19", 7248, 8042, -794 },
        { "2020-10-26", 7492, 6184, 1308 },
        { "2020-11-02", 8504, 5695, 2809 },
        { "2020-11-09", 7982, 7990, -8 },
        { "2020-11-16", 7371, 7823, -452 },
        { "2020-11-23", 7245, 6649, 596 },
        { "2020-11-30", 8217, 6427, 1790 },
        { "2020-12-07", 7670, 6717, 953 },
        { "2020-12-14", 6770, 5921, 849 },
        { "2020-12-21", 6222, 5188, 1034 },
        { "2020-12-28", 4735, 4903, -168 }
        }
    )
VAR compared =
    ADDCOLUMNS (
        expected,
        "In", VAR w = [Week] RETURN CALCULATE ( [Requests In], dim_date[week_start] = w ),
        "Done", VAR w = [Week] RETURN CALCULATE ( [Completions], dim_date[week_start] = w ),
        "Net", VAR w = [Week] RETURN CALCULATE ( [Net Change], dim_date[week_start] = w )
    )
VAR checked = ADDCOLUMNS ( compared, "ok", [In] = [In (pipeline)] && [Done] = [Done (pipeline)] && [Net] = [Net (pipeline)] )
VAR failures = FILTER ( checked, NOT [ok] )
RETURN
    ROW (
        "Test", "Requests In, Completions and Net Change by week",
        "Checks", COUNTROWS ( checked ),
        "Passed", COUNTROWS ( checked ) - COUNTROWS ( failures ),
        "Result", IF ( ISEMPTY ( failures ), "PASS", "FAIL" ),
        "First failure", CONCATENATEX ( TOPN ( 1, failures, FORMAT ( [Week], "yyyy-mm-dd" ), ASC ), FORMAT ( [Week], "yyyy-mm-dd" ) )
    )
