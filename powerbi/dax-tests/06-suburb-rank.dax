        { "2020-12-31", "Reticulation Water Distribution", "Unknown suburb", BLANK (), 170, BLANK () }
        }
    )
VAR compared =
    ADDCOLUMNS (
        expected,
        "Rank", VAR d = [As at] VAR s = [Section] VAR b = [Suburb] RETURN CALCULATE ( [Suburb Rank], as_at[as_at_date] = d, dim_section[section] = s, dim_suburb[suburb] = b ),
        "Active", VAR d = [As at] VAR s = [Section] VAR b = [Suburb] RETURN IF ( b = "Unknown suburb", CALCULATE ( [Unknown Suburb Active], as_at[as_at_date] = d, dim_section[section] = s ), CALCULATE ( [Active], as_at[as_at_date] = d, dim_section[section] = s, dim_suburb[suburb] = b ) ),
        "WTC", VAR d = [As at] VAR s = [Section] VAR b = [Suburb] RETURN IF ( b = "Unknown suburb", BLANK (), CALCULATE ( [Weeks to Clear], as_at[as_at_date] = d, dim_section[section] = s, dim_suburb[suburb] = b ) )
    )
VAR checked = ADDCOLUMNS ( compared, "ok", IF ( ISBLANK ( [Rank (pipeline)] ), ISBLANK ( [Rank] ), NOT ISBLANK ( [Rank] ) && ABS ( [Rank] - [Rank (pipeline)] ) < 0.000001 ) && [Active] = [Active (pipeline)] && IF ( ISBLANK ( [WTC (pipeline)] ), ISBLANK ( [WTC] ), NOT ISBLANK ( [WTC] ) && ABS ( [WTC] - [WTC (pipeline)] ) < 0.000001 ) )
VAR failures = FILTER ( checked, NOT [ok] )
RETURN
    ROW (
        "Test", "Suburb Rank inside flagged sections",
        "Checks", COUNTROWS ( checked ),
        "Passed", COUNTROWS ( checked ) - COUNTROWS ( failures ),
        "Result", IF ( ISEMPTY ( failures ), "PASS", "FAIL" ),
        "First failure", CONCATENATEX ( TOPN ( 1, failures, FORMAT ( [As at], "yyyy-mm-dd" ) & " " & [Section] & " " & [Suburb], ASC ), FORMAT ( [As at], "yyyy-mm-dd" ) & " " & [Section] & " " & [Suburb] )
    )
